# Set these in your host's private environment variables. Do not commit real passwords.
ISSUER=https://YOUR-HB-ID.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
PORT=3000

# Optional: automatic Wallet pass creation. Set privately on the host; leave blank to disable.
WALLETWALLET_API_KEY=

# Optional: Spaceship / Spacemail verification and password-reset emails.
# Store SMTP_PASSWORD privately in Vercel as a Secret (Sensitive), Production only.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=you@your-domain.example
EMAIL_FROM=you@your-domain.example
SMTP_PASSWORD=

# Optional Supabase email-code sign-in. Use only a publishable key, never service_role.
# Keep the switch false until custom SMTP and code email templates are configured.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_ENABLED=false
