# Set these in your host's private environment variables. Do not commit real passwords.
ISSUER=https://YOUR-HB-ID.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
PORT=3000

# Optional: automatic Wallet pass creation. Set privately on the host; leave blank to disable.
WALLETWALLET_API_KEY=
